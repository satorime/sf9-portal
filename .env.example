# Postgres connection string (Vercel Postgres, Neon, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Vercel Blob storage token, used for storing the uploaded school logo
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Random secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Seeded admin account (prisma/seed.ts)
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="change-me-after-first-login"

# Seeded school profile (prisma/seed.ts)
SCHOOL_SEED_NAME="Sample National High School"
SCHOOL_SEED_ADDRESS="Sample Address, Philippines"
SCHOOL_SEED_YEAR="2025-2026"
